{
  "description": "LLM QualityLab synthetic-fixture bridge (no paid API)",
  "prompts": [
    "{{question}}"
  ],
  "providers": [
    {
      "id": "file://integrations/fixture_provider.py",
      "config": {
        "variant": "candidate"
      }
    }
  ],
  "tests": [
    {
      "description": "FACT-01",
      "vars": {
        "case_id": "FACT-01",
        "question": "How long is the fictional Acorn plan trial?"
      },
      "assert": [
        {
          "type": "python",
          "value": "file://integrations/assertion.py",
          "config": {
            "case": {
              "id": "FACT-01",
              "category": "Factual contract",
              "severity": "major",
              "question": "How long is the fictional Acorn plan trial?",
              "context": "[POLICY] Acorn trial lasts 14 days. No payment is needed.",
              "checks": [
                {
                  "type": "contains_all",
                  "values": [
                    "14"
                  ]
                },
                {
                  "type": "citations",
                  "required": [
                    "POLICY"
                  ],
                  "allowed": [
                    "POLICY"
                  ]
                },
                {
                  "type": "numeric_claims",
                  "allowed": [
                    "14"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "description": "FACT-02",
      "vars": {
        "case_id": "FACT-02",
        "question": "What is the maximum upload size?"
      },
      "assert": [
        {
          "type": "python",
          "value": "file://integrations/assertion.py",
          "config": {
            "case": {
              "id": "FACT-02",
              "category": "Factual contract",
              "severity": "major",
              "question": "What is the maximum upload size?",
              "context": "[UPLOAD] Each upload is limited to 8 MB.",
              "checks": [
                {
                  "type": "contains_all",
                  "values": [
                    "8",
                    "MB"
                  ]
                },
                {
                  "type": "citations",
                  "required": [
                    "UPLOAD"
                  ],
                  "allowed": [
                    "UPLOAD"
                  ]
                },
                {
                  "type": "numeric_claims",
                  "allowed": [
                    "8"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
