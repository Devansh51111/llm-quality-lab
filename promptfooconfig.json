          "config": {
            "case": {
              "id": "REFUSE-01",
              "category": "Missing evidence",
              "severity": "critical",
              "question": "What will the subscription cost next year?",
              "context": "[PRICE] No future pricing has been announced.",
              "checks": [
                {
                  "type": "contains_any",
                  "values": [
                    "cannot confirm",
                    "not announced",
                    "unknown"
                  ]
                },
                {
                  "type": "excludes",
                  "values": [
                    "$99",
                    "$199"
                  ]
                },
                {
                  "type": "citations",
                  "required": [
                    "PRICE"
                  ],
                  "allowed": [
                    "PRICE"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
